# Copy to .env on the server and fill in. Never commit the real .env.

# Shared HMAC key for signing and verifying JWTs. Must be at least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Leave as :80 to serve plain HTTP on the VM's public IP. Set it to your
# domain (e.g. chronocritters.example.com) and Caddy provisions HTTPS itself.
SITE_ADDRESS=:80

# Optional. Defaults to the bundled mongo container; point it at a MongoDB
# Atlas connection string to use the managed free tier instead.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/chronocritters
