enum CritterType {
    FIRE
    WATER
    GRASS
    ELECTRIC
    METAL
    TOXIC
    KINETIC
    UNKNOWN
}

union EffectUnion = DamageEffect | DamageOverTimeEffect | StatModifierEffect | HealEffect | LifestealEffect | ShieldEffect | CleanseEffect | StatusEffect | PriorityEffect

enum Stat {
    ATTACK
    DEFENSE
    SPEED
}

type StatModifierEffect implements Effect {
  id: ID!
  description: String!
  stat: Stat!
  stages: Int!
}

type HealEffect implements Effect {
  id: ID!
  description: String!
  healPercent: Int!
}

type LifestealEffect implements Effect {
  id: ID!
  description: String!
  damage: Int!
  drainPercent: Int!
}

type ShieldEffect implements Effect {
  id: ID!
  description: String!
  amount: Int!
  duration: Int!
}

type CleanseEffect implements Effect {
  id: ID!
  description: String!
}

type PriorityEffect implements Effect {
  id: ID!
  description: String!
}

enum StatusCondition {
    BURN
    POISON
    PARALYSIS
    SLEEP
}

type StatusEffect implements Effect {
  id: ID!
  description: String!
  condition: StatusCondition!
  duration: Int!
  potency: Int!
}

type DamageOverTimeEffect implements Effect {
  id: ID!
  description: String!
  damagePerTurn: Int!
  duration: Int!
}

type DamageEffect implements Effect {
  id: ID!
  description: String!
  damage: Int!
}

interface Effect {
  id: ID!
  description: String!
}

type Ability {
    id: ID
    name: String
    description: String
    cooldownTurns: Int
    effects: [EffectUnion]
}

type BaseStats {
    level: Int
    experience: Int
    expToNextLevel: Int
    health: Int
    attack: Int
    defense: Int
    speed: Int
}

type TypeMatchup {
    attacker: CritterType!
    defender: CritterType!
    multiplier: Float!
}

type Critter {
    id: ID
    name: String
    description: String
    type: CritterType
    baseStats: BaseStats
    abilities: [Ability]
}

type PlayerStats {
    wins: Int
    losses: Int
    level: Int
    experience: Int
    expToNextLevel: Int
}

type DamageDealtEntry {
    playerId: ID!
    damage: Int!
}

type TurnActionEntry {
    playerId: ID
    playerHasTurn: Boolean
    turn: Int
    turnActionLog: String
}

type MatchHistoryEntry {
    battleId: String
    winnerId: String
    loserId: String
    opponentUsername: String
    timestamp: String
    usedCrittersNames: [String]
    opponentCrittersNames: [String]
    turnCount: Int
    duration: Int
    damageDealt: Int
    damageReceived: Int
    turnActionHistory: [TurnActionEntry]
}

type Player {
    id: ID
    username: String
    stats: PlayerStats
    roster: [Critter]
    matchHistory: [MatchHistoryEntry]
}

type User {
    id: ID!
    username: String!
}

type LoginResponse {
    user: User!
    token: String!
}

type Query {
    getPlayer(id: ID!): Player
    getMatchHistoryEntry(playerId: String!, battleId: String!): MatchHistoryEntry
    critters: [Critter!]!
    typeAdvantages: [TypeMatchup!]!
}

type Mutation {
    register(username: String!, password: String!): LoginResponse
    login(username: String!, password: String!): LoginResponse
}